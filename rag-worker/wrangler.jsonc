{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "velora-dune-rag",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],

  "ai": {
    "binding": "AI"
  },

  "vectorize": [
    {
      "binding": "VECTORIZE_INDEX",
      "index_name": "velora-dune-kb"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT_KV",
      "id": "c1066e56cab94c109e3d5380a3a2993d"
    }
  ],

  "vars": {
    "ALLOWED_ORIGINS": "https://velora-dune.vercel.app",
    "GENERATION_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "RETRIEVAL_TOP_K": "5",
    "SIMILARITY_THRESHOLD": "0.5",
    "MAX_MESSAGE_LENGTH": "500",
    "MAX_HISTORY_TURNS": "6",
    "MAX_ANSWER_TOKENS": "600",
    "RATE_LIMIT_PER_MINUTE": "15",
    "RATE_LIMIT_PER_DAY": "100"
  },

  "d1_databases": [
    {
      "binding": "RESERVATIONS_DB",
      "database_name": "velora-dune-reservations",
      "database_id": "2348b970-9a80-43a3-a43a-3492450faf31"
    }
  ]
}
